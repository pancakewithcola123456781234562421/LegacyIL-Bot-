import { SlashCommandBuilder, PermissionFlagsBits, MessageFlags } from 'discord.js';
import { createEmbed, errorEmbed, successEmbed } from '../../utils/embeds.js';
import { logger } from '../../utils/logger.js';
import { InteractionHelper } from '../../utils/interactionHelper.js';

export default {
    data: new SlashCommandBuilder()
        .setName("announcement")
        .setDescription("שלח הודעת הכרזה לערוץ מסוים")
        .addChannelOption(option =>
            option
                .setName("channel")
                .setDescription("הערוץ לשליחת ההכרזה")
                .setRequired(true)
        )
        .addStringOption(option =>
            option
                .setName("message")
                .setDescription("ההודעה להכרזה")
                .setRequired(true)
        )
        .setDefaultMemberPermissions(PermissionFlagsBits.Administrator),

    async execute(interaction, config, client) {
        try {
            const channel = interaction.options.getChannel("channel");
            const message = interaction.options.getString("message");

            await channel.send({
                content: "@everyone",
                embeds: [
                    successEmbed(
                        "📢 הכרזה חשובה",
                        message
                    ).setFooter({
                        text: `משודר על ידי ${interaction.user.tag}`
                    })
                ]
            });

            return await InteractionHelper.safeReply(interaction, {
                embeds: [
                    successEmbed(
                        "הכרזה נשלחה",
                        `הודעה נשלחה בהצלחה ל-${channel}`
                    )
                ],
                flags: MessageFlags.Ephemeral
            });
        } catch (error) {
            logger.error('Announcement command error:', error);
            return await InteractionHelper.safeReply(interaction, {
                embeds: [
                    errorEmbed("שגיאה", "נכשל לשלוח הכרזה")
                ],
                flags: MessageFlags.Ephemeral
            });
        }
    }
};
